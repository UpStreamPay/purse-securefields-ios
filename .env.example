# Copy to .env (gitignored) and fill in real values to run the Demo app. Then run
# `source scripts/load-env.sh` once per login session before building/opening Xcode — see
# scripts/load-env.sh for why a plain `export` isn't enough for a GUI-launched Xcode.

# Merchant/tenant identifier used by the demo app.
TENANT_ID=

# Api key for remote log monitoring (Datadog). Leave blank to run the demo with monitoring
# disabled — Demo/Resources/Info.plist resolves $(MONITORING_API_KEY) to an empty string.
MONITORING_API_KEY=

# Purse 3DS — the Demo's merchant backend, Alfred (usp-widget/packages/alfred). It serves the
# app SDK configuration at launch (GET /app_sdk_configuration) and the advanced-flow payment
# (POST /create_payment). Blank on the simulator means http://localhost:9001, Alfred's default.
MERCHANT_BACKEND_URL=

# The entity those calls are scoped to; its Purse Vault tenant must be TENANT_ID. Blank uses the
# entity of the Demo's default tenant, on `test`.
ENTITY_ID=

# NETCETERA_API_KEY: used only when no merchant backend answers — the Demo then builds the app
# SDK configuration locally. Issued per organisation by Netcetera and time-limited; never
# committed. With no backend and no key, submit(threeDSEnabled:) reports
# .threeDS(.configurationMissing).
NETCETERA_API_KEY=
